{
  "name": "pi-herdr-subagents",
  "version": "1.2.1",
  "private": true,
  "description": "Visible, one-shot Pi subagents hosted by Herdr",
  "keywords": [
    "pi-package"
  ],
  "type": "module",
  "scripts": {
    "check": "pnpm typecheck && pnpm lint && pnpm format:check",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint .",
    "format": "oxfmt src test package.json pnpm-workspace.yaml tsconfig.json .oxlintrc.json .oxfmtrc.json",
    "format:check": "oxfmt --check src test package.json pnpm-workspace.yaml tsconfig.json .oxlintrc.json .oxfmtrc.json",
    "test": "tsx --test test/**/*.test.ts"
  },
  "dependencies": {
    "mnemonic-id": "^4.1.0"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.84.1",
    "@earendil-works/pi-coding-agent": "0.84.1",
    "@earendil-works/pi-tui": "0.84.1",
    "@oxlint/plugins": "1.78.0",
    "@types/node": "^24.0.0",
    "oxfmt": "0.63.0",
    "oxlint": "1.78.0",
    "tsx": "^4.0.0",
    "typebox": "^1.3.6",
    "typescript": "^5.0.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "packageManager": "pnpm@11.18.0",
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  }
}
