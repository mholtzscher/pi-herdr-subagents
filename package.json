{
  "name": "pi-herdr-subagents",
  "version": "1.5.0",
  "private": true,
  "description": "Visible, one-shot Pi subagents hosted by Herdr",
  "keywords": [
    "pi-package"
  ],
  "type": "module",
  "scripts": {
    "check": "ultracite check --type-aware --type-check",
    "fix": "ultracite fix --type-aware --type-check",
    "test": "tsx --test test/**/*.test.ts"
  },
  "dependencies": {
    "mnemonic-id": "^4.1.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^0.84.2",
    "@earendil-works/pi-coding-agent": "^0.84.2",
    "@earendil-works/pi-tui": "^0.84.2",
    "@types/node": "^24.13.3",
    "oxfmt": "0.63.0",
    "oxlint": "1.78.0",
    "oxlint-tsgolint": "^7.0.2001",
    "tsx": "^4.23.12",
    "typebox": "^1.3.14",
    "typescript": "^5.9.3",
    "ultracite": "7.10.5"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "packageManager": "pnpm@11.18.0",
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  }
}
